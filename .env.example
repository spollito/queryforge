# Local development configuration.
#   cp .env.example .env
# .env is git-ignored. Never commit real credentials.
#
# Read by Docker Compose (compose.yaml), the API (imported by Spring Boot), and
# the web app (Vite exposes VITE_* variables only). Do not quote values: the API
# reads this file in Java properties format.

# PostgreSQL (Docker Compose and API)
POSTGRES_DB=queryforge
POSTGRES_USER=queryforge
# Local development only. Replace with your own value.
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Sample target database (Docker Compose service sample-db). QueryForge
# analyzes queries against it as the read-only queryforge_reader role.
SAMPLE_DB_PORT=5433
# Dataset size multiplier: 1 = 500k orders (about a minute to generate).
SAMPLE_SCALE=1

# Target database the API analyzes (defaults point at sample-db).
TARGET_DB_URL=jdbc:postgresql://localhost:5433/sample
TARGET_DB_USER=queryforge_reader
# Local development only. Replace with your own value.
TARGET_DB_PASSWORD=change-me-too
# Optional: TARGET_DB_STATEMENT_TIMEOUT=10s, TARGET_DB_TIME_ZONE=UTC

# API (Spring Boot)
API_PORT=8080
# Comma-separated browser origins allowed to call the API.
API_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Web (Vite). Embedded in the browser bundle, so never put secrets here.
# Keep in step with API_PORT.
VITE_API_BASE_URL=http://localhost:8080
